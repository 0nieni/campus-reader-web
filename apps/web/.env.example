# This environment ID is public configuration, not a credential.
VITE_CLOUDBASE_ENV_ID=cloudbase-d3gw62aemba0c819e
# Official SDK default; verify with the real environment before deployment.
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_REGION_VERIFIED=false
VITE_CLOUDBASE_FUNCTION=webGateway
VITE_CLOUDBASE_AI_FUNCTION=webAi
# Netlify builds set this to netlify; the local default still uses CloudBase.
VITE_AI_EXECUTOR=cloudbase
# Optional: password login can establish its own authenticated session without this.
VITE_CLOUDBASE_PUBLISHABLE_KEY=
# Set to true only after checking the username/password provider in the console.
VITE_CLOUDBASE_PASSWORD_READY=false
# Never put a password, owner UID/OPENID, management secret or model key here.
